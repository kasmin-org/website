# www.kasmin.org (production, branch main): HTTPS only, canonical host www.kasmin.org, security headers.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.kasmin\.org$ [NC]
RewriteRule ^ https://www.kasmin.org%{REQUEST_URI} [R=301,L]

# Documentation of a version: the pages are built without the dot (docs/021/…), links use the version number (docs/0.21/…).
RewriteRule ^((?:de/)?docs/)(\d+)\.(\d+)(/.*)?$ /$1$2$3$4 [R=302,L]

# The documentation of a version that is not published (yet): show the latest one instead of "not found". This
# covers the minutes between a release of Kasmin and the next build of this site.
RewriteCond %{DOCUMENT_ROOT}/$1$2 !-d
RewriteRule ^((?:de/)?docs/)(\d+)(/.*)?$ /$1latest$3 [R=302,L]

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

ErrorDocument 404 /404.html
DirectoryIndex index.html
