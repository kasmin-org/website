# www-dev.kasmin.org (development, branch develop): public, but not indexed by search engines.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Documentation of a version: the pages are built without the dot (docs/021/…), links use the version number (docs/0.21/…).
RewriteRule ^((?:de/)?docs/)(\d+)\.(\d+)(/.*)?$ /$1$2$3$4 [R=302,L]

# The documentation of a version that is not published (yet): show the latest one instead of "not found". This
# covers the minutes between a release of Kasmin and the next build of this site.
RewriteCond %{DOCUMENT_ROOT}/$1$2 !-d
RewriteRule ^((?:de/)?docs/)(\d+)(/.*)?$ /$1latest$3 [R=302,L]

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

ErrorDocument 404 /404.html
DirectoryIndex index.html
